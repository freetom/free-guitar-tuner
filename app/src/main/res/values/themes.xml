<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GuitarTuner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/surface</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <!-- Override default TextView style to never apply a background -->
        <item name="android:textViewStyle">@style/Widget.GuitarTuner.TextView</item>
    </style>

    <!-- Plain TextView with no background whatsoever -->
    <style name="Widget.GuitarTuner.TextView" parent="android:Widget.TextView">
        <item name="android:background">@null</item>
    </style>

    <style name="StringLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_string_label</item>
        <item name="android:layout_margin">3dp</item>
    </style>
</resources>
